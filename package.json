{
  "name": "env-streamer-mode",
  "displayName": "ENV Streamer Mode",
  "description": "Automatically protect .env files when OBS Studio is detected running. Blocks file content until you confirm it's safe to view.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "goncy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "streamer",
    "streaming",
    "obs",
    "env",
    "dotenv",
    "security",
    "privacy",
    "secrets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goncy/env-streamer-mode-vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "customEditors": [
      {
        "viewType": "envStreamerMode.protectedEditor",
        "displayName": "ENV Protected View",
        "selector": [
          { "filenamePattern": ".env" },
          { "filenamePattern": ".env.*" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "envStreamerMode.toggle",
        "title": "Toggle Streamer Mode",
        "category": "ENV Streamer Mode"
      }
    ],
    "configuration": {
      "title": "ENV Streamer Mode",
      "properties": {
        "envStreamerMode.autoDetectOBS": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect OBS Studio and activate streamer mode."
        },
        "envStreamerMode.pollInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 2000,
          "maximum": 30000,
          "description": "How often to check if OBS is running (in milliseconds)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node esbuild.js --production",
    "watch:esbuild": "node esbuild.js --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
